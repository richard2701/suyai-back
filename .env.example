HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified


CLOUDINARY_NAME=<cloud name>
CLOUDINARY_KEY=<api key>
CLOUDINARY_SECRET=<api secret>
CLOUDINARY_FOLDER=<whatever folder prod uses, e.g. "dev">

# Comma-separated exact SPA origins allowed by CORS (required in production).
# FRONTEND_URL=https://example.com,https://www.example.com
# Header with the real client IP behind the proxy (default: cf-connecting-ip).
# PROXY_IP_HEADER=cf-connecting-ip
# Public form submissions allowed per IP per window (defaults: 5 / 10 minutes).
# FORM_RATE_LIMIT_MAX=5
# FORM_RATE_LIMIT_WINDOW_MINUTES=10
