{
  "kind": "collectionType",
  "collectionName": "form_reservation_transfers",
  "info": {
    "singularName": "form-reservation-transfer",
    "pluralName": "form-reservation-transfers",
    "displayName": "Form reservation transfer"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "emailSent": {
      "type": "boolean",
      "default": false
    },
    "phone": {
      "type": "text",
      "required": true
    },
    "message": {
      "type": "text",
      "maxLength": 2000
    },
    "transferDate": {
      "type": "date",
      "required": true
    },
    "lastname": {
      "type": "string",
      "required": true
    },
    "people": {
      "type": "integer",
      "required": true
    },
    "destination": {
      "type": "string",
      "required": true
    },
    "pickupTime": {
      "type": "time",
      "required": true
    }
  }
}