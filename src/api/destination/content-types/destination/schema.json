{
  "kind": "collectionType",
  "collectionName": "destinations",
  "info": {
    "singularName": "destination",
    "pluralName": "destinations",
    "displayName": "Destination",
    "description": "Travel destinations shown in tiles and the search dropdown"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "showInSearch": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "order": {
      "type": "integer"
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "tour_area",
        "transfer_only"
      ],
      "default": "tour_area"
    },
    "tours": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "inversedBy": "destinations"
    }
  }
}
