{
  "kind": "collectionType",
  "collectionName": "form_reservation_tours",
  "info": {
    "singularName": "form-reservation-tour",
    "pluralName": "form-reservation-tours",
    "displayName": "form reservation tour",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "emailSent": {
      "type": "boolean",
      "default": false
    },
    "phone": {
      "type": "text",
      "required": true
    },
    "message": {
      "type": "text",
      "maxLength": 2000
    },
    "tourDate": {
      "type": "date",
      "required": true
    },
    "tourName": {
      "type": "string",
      "required": true
    },
    "lastname": {
      "type": "string",
      "required": true
    },
    "tourId": {
      "type": "string"
    },
    "people": {
      "type": "integer",
      "required": true
    },
    "article": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::article.article"
    }
  }
}
